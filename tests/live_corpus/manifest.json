      "history": 10,
      "gallery": 12
     }
    }
   }
  },
  "image_offset": {
   "target": "[data-m~=\"photo\"]",
   "what": "one photo is moved by whole pixels",
   "kind": "mutation",
   "js": "els[0].style.transform = `translateX(${v}px)`",
   "magnitudes": {
    "plus1px": {
     "label": "SIGNAL",
     "values": {
      "history": 1,
      "gallery": 1
     },
     "why": "a layout that moved by one pixel is a layout that changed (decided by the maintainer on 2026-09-28)"
    },
    "plus2px": {
     "label": "SIGNAL",
     "values": {
      "history": 2,
      "gallery": 2
     }
    }
   }
  },
  "image_crop": {
   "target": "[data-m~=\"photo\"]",
   "what": "the crop of one photo moves (object-position)",
   "kind": "mutation",
   "js": "els[0].style.objectPosition = `calc(50% + ${v}px) 50%`",
   "magnitudes": {
    "plus4px": {
     "label": "SIGNAL",
     "values": {
      "history": 4,
      "gallery": 4
     }
    },
    "plus12px": {
     "label": "SIGNAL",
     "values": {
      "history": 12,
      "gallery": 12
     }
    }
   }
  }
 },
