{
 "format": 1,
 "about": "Live corpus of VisTest: part of a page a fraction of a pixel off, and real changes of the same photos. Written by `python scripts/live_corpus.py --regenerate`; do not edit.",
 "environment": {
  "playwright": "1.56.0",
  "chromium": "141.0.7390.37",
  "browser_build": "chromium_headless_shell-1194",
  "browser_product": "HeadlessChrome/141.0.7390.37",
  "os": "Linux",
  "os_version": "Ubuntu 24.04.5 LTS",
  "arch": "x86_64",
  "distro": "Ubuntu 24.04.5 LTS",
  "python": "3.11.17",
  "viewport": {
   "width": 1280,
   "height": 800
  },
  "device_scale_factor": 1,
  "container": {
   "image": null,
   "in_container": false
  },
  "host": {
   "dpi": null,
   "dpi_source": "no display: headless",
   "font_smoothing": null
  },
  "capture": {
   "via": "vistest.library.targets.capture",
   "screenshot": {
    "type": "png",
    "animations": "disabled",
    "caret": "hide",
    "scale": "css"
   },
   "before": "document.fonts.ready",
   "stability": "frames until two in a row are byte-identical, 5000 ms limit"
  }
 },
 "control": "every frame drawn in two browsers started the same way; 0 pixels apart, or the capture stops",
 "storage": "lossless WebP; the pixels of the PNG the capture returned",
 "split": {
  "rule": "by template: history is for calibration; gallery is held out — it never takes part in choosing a threshold or any other constant of the engine, and is measured once a choice has been made on history",
  "calibration": [
   "history"
  ],
  "held_out": [
   "gallery"
  ],
  "spent": {
   "gallery": "2026-10-14, v13 attempt 1 (the rule «a picture drawn a fraction of a pixel over»): measured once after the choice on history — 6 of 6 false failures and a new miss (image_tint/de4); rolled back. A second attempt is measured on a template drawn after this date"
  }
 },
 "labels": {
  "SIGNAL": "the page changed; a tool must fail",
  "NOISE": "nobody changed the page; a tool must pass",
  "DISPUTED": "printed, never counted"
 },
 "renderer": {
  "file": "renderers/base.png",
  "sha256": "72b61404d763bf46809d22e682d29ae7968550772042c2faeb8b67c58aaf83ea",
  "via": "vistest.library.canary.draw"
 },
 "templates": {
  "history": {
   "title": "a list of trips with rounded photo thumbnails",
   "split": "calibration",
   "base": "frames/history/base.webp",
   "sha256": "6652a8cb7c6f5b158a15a1893edc44cf27bb028c1e5c0f53068477fc4a24e409",
   "fonts": [
    {
     "family": "DejaVu Sans",
     "postscript": "DejaVuSans",
     "custom": true,
     "glyphs": 426
    },
    {
     "family": "DejaVu Sans",
     "postscript": "DejaVuSans-Bold",
     "custom": true,
     "glyphs": 292
    }
   ]
  },
  "gallery": {
   "title": "a grid of large rounded photos, captions, badges, a dark header",
   "split": "held_out",
   "base": "frames/gallery/base.webp",
   "sha256": "84f828101a620baa0ba5856649acfa58fd59240187f039f7a025f13088abe9cb",
   "fonts": [
    {
     "family": "DejaVu Sans",
     "postscript": "DejaVuSans",
     "custom": true,
     "glyphs": 240
    },
    {
     "family": "DejaVu Sans",
     "postscript": "DejaVuSans-Bold",
     "custom": true,
     "glyphs": 157
    }
   ]
  }
 },
 "families": {
  "part_shift": {
   "target": "[data-m~=\"part\"]",
   "what": "the block of photos and text is moved by a fraction of a pixel (transform)",
   "kind": "noise",
   "js": "els[0].style.transform = `translate(${v}px, ${v}px)`",
   "magnitudes": {
    "0_1px": {
     "label": "NOISE",
     "values": {
      "history": 0.1,
      "gallery": 0.1
     },
     "why": "decided by the maintainer on 2026-10-14: a part of the page a fraction of a pixel off, under half a pixel, is NOISE — as for the whole page shifted by 0.25 px. Nobody changed it"
    },
    "0_25px": {
     "label": "NOISE",
     "values": {
      "history": 0.25,
      "gallery": 0.25
     },
     "why": "decided by the maintainer on 2026-10-14: a part of the page a fraction of a pixel off, under half a pixel, is NOISE — as for the whole page shifted by 0.25 px. Nobody changed it"
    },
    "0_4px": {
     "label": "NOISE",
     "values": {
      "history": 0.4,
      "gallery": 0.4
     },
     "why": "decided by the maintainer on 2026-10-14: a part of the page a fraction of a pixel off, under half a pixel, is NOISE — as for the whole page shifted by 0.25 px. Nobody changed it"
    },
    "0_5px": {
     "label": "DISPUTED",
     "values": {
      "history": 0.5,
      "gallery": 0.5
     },
     "why": "decided by the maintainer on 2026-10-14: at half a pixel the text of the block jumps by a whole pixel against the rest of the page. DISPUTED: printed, never counted"
    }
   }
  },
  "image_shift": {
   "target": "[data-m~=\"part\"]",
   "what": "only the photos of the block are moved by a fraction of a pixel",
   "kind": "noise",
   "js": "els[0].querySelectorAll('img').forEach(i => { i.style.transform = `translateX(${v}px)`; })",
   "magnitudes": {
    "0_1px": {
     "label": "NOISE",
     "values": {
      "history": 0.1,
      "gallery": 0.1
     },
     "why": "decided by the maintainer on 2026-10-14: a part of the page a fraction of a pixel off, under half a pixel, is NOISE — as for the whole page shifted by 0.25 px. Nobody changed it"
    },
    "0_25px": {
     "label": "NOISE",
     "values": {
      "history": 0.25,
      "gallery": 0.25
     },
     "why": "decided by the maintainer on 2026-10-14: a part of the page a fraction of a pixel off, under half a pixel, is NOISE — as for the whole page shifted by 0.25 px. Nobody changed it"
    },
    "0_4px": {
     "label": "NOISE",
     "values": {
      "history": 0.4,
      "gallery": 0.4
     },
     "why": "decided by the maintainer on 2026-10-14: a part of the page a fraction of a pixel off, under half a pixel, is NOISE — as for the whole page shifted by 0.25 px. Nobody changed it"
    }
   }
  },
  "image_swap": {
   "target": "[data-m~=\"photo\"]",
   "what": "one photo is replaced by another",
   "kind": "mutation",
   "js": "els[0].src = v",
   "magnitudes": {
    "other": {
     "label": "SIGNAL",
     "values": {
      "history": "photos/h9.webp",
      "gallery": "photos/g9.webp"
     }
    }
   }
  },
  "image_tint": {
   "target": "[data-m~=\"photo\"]",
   "what": "one photo is tinted warm (median ΔE00 over the photo)",
   "kind": "mutation",
   "js": "els[0].src = v",
   "magnitudes": {
    "de2": {
     "label": "DISPUTED",
     "values": {
      "history": "photos/h3.tint2.webp",
      "gallery": "photos/g2.tint2.webp"
     },
     "why": "decided by the maintainer on 2026-09-28: ΔE00 ≈ 2 sits at the edge of what a person sees side by side. DISPUTED, as in the browser corpus"
    },
    "de4": {
     "label": "SIGNAL",
     "values": {
      "history": "photos/h3.tint4.webp",
      "gallery": "photos/g2.tint4.webp"
     }
    },
    "de8": {
     "label": "SIGNAL",
     "values": {
      "history": "photos/h3.tint8.webp",
      "gallery": "photos/g2.tint8.webp"
     }
    }
   }
  },
  "image_radius": {
   "target": "[data-m~=\"photo\"]",
   "what": "the corner radius of one photo",
   "kind": "mutation",
   "js": "els[0].style.borderRadius = v + 'px'",
   "magnitudes": {
    "plus2px": {
     "label": "SIGNAL",
     "values": {
      "history": 14,
      "gallery": 16
     }
    },
    "minus2px": {
     "label": "SIGNAL",
