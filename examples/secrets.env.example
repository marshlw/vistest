# Copy this file to .vistest/secrets.env and fill it in. .vistest/ is in
# .gitignore, so the real file stays out of the repository; this example is
# the only one that is committed.
#
# Values are put into scenario steps by name: ${VISTEST_USER}. A name that is
# not set stops the run with a clear error, instead of typing an empty
# password and leaving you a diff nobody can explain.
#
# In CI, set the same names as secret environment variables; no file is needed.

BASE_URL=https://staging.example.com
VISTEST_USER=qa@example.com
VISTEST_PASSWORD=
