# What goes into the sdist on top of the `vistest` package.
#
# The examples and the tests live outside the package, so setuptools will not
# pick them up on its own. Nothing of the server's is here: it is a package of
# its own, with its own archives.

include README.md README.ru.md
include LICENSE NOTICE CONTRIBUTORS.md
#  What checks a build before it is uploaded; tests/test_dist_audit.py needs the first.
include scripts/audit_dist.py scripts/check_install.py

recursive-include examples *
recursive-include tests *.py

# Never ship these
global-exclude __pycache__ *.py[cod] .DS_Store
prune .vistest
prune .venv
prune .idea
prune _private
prune tests/pages
