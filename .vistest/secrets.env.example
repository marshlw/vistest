# Скопируйте в .vistest/secrets.env и заполните.
# Настоящий файл secrets.env в .gitignore и в репозиторий не попадёт.
#
# Значения подставляются в шаги сценария по имени: ${VISTEST_USER}.
# Если переменная не задана, VisTest падает с понятной ошибкой — а не вводит
# пустой пароль и не оставляет разбираться с непонятным диффом.
#
# В CI эти же имена задаются как секреты окружения, файл не нужен.

BASE_URL=https://stage.my-app.local
VISTEST_USER=qa@example.com
VISTEST_PASSWORD=

# Только если включён LLM-каптионер (ai.captioner_enabled)
# ANTHROPIC_API_KEY=
