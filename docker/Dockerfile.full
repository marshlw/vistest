# «Толстый» образ для команды: сервис ревью + браузер + окно записи (noVNC).
#
# api-образ намеренно лёгкий и без браузера, поэтому в нём недоступны запись
# эталонов мышью и прогон pytest. Этот образ добавляет браузер (та же прибитая
# версия Playwright, что у раннера — детерминированный рендер) и виртуальный
# дисплей с noVNC, чтобы интерактивная запись мышью работала даже когда сервис —
# контейнер на ВМ без экрана. Команда открывает UI на :8420 и окно записи на
# :6080, и пользуется ВСЕМИ функциями: запись, снятие, прогоны, метрики.
#
# Базовый образ (с mcr.microsoft.com — обычно доступен даже когда Docker Hub
# нет) вынесен в build-arg: при недоступном реестре укажите зеркало через
#   --build-arg BASE_IMAGE=<зеркало>/playwright/python:v1.47.0-jammy
ARG BASE_IMAGE=mcr.microsoft.com/playwright/python:v1.47.0-jammy
FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VISTEST_ROOT=/data \
    VISTEST_IN_DOCKER=1 \
    DISPLAY=:99 \
    TZ=UTC \
    VISTEST_CHROMIUM_ARGS="--font-render-hinting=none --disable-lcd-text --disable-gpu --force-color-profile=srgb --disable-skia-runtime-opts --deterministic-mode --hide-scrollbars"

# Фиксированный набор шрифтов (иначе метрики текста плывут и ломают эталоны),
# плюс лёгкий стек виртуального дисплея и noVNC для интерактивной записи.
# DEBIAN_FRONTEND=noninteractive обязателен: без него tzdata (зависимость
# noVNC-стека) спрашивает часовой пояс и билд зависает на этом вопросе.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        --no-install-recommends \
        tzdata \
        fonts-liberation2 fonts-dejavu-core fonts-noto-core \
        fonts-noto-cjk fonts-noto-color-emoji \
        curl xvfb x11vnc novnc websockify fluxbox \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY vistest ./vistest
COPY frontend ./frontend
COPY docker/entrypoint.sh /usr/local/bin/vistest-entrypoint
RUN pip install -e ".[full]" \
    && chmod +x /usr/local/bin/vistest-entrypoint

VOLUME /data
EXPOSE 8420 6080

HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD curl -fsS http://localhost:8420/api/health || exit 1

ENTRYPOINT ["/usr/local/bin/vistest-entrypoint"]
