# Сервис: API + ревью-UI. Без браузера — образ лёгкий.
#
# Базовый образ вынесен в build-arg: в закрытом контуре или при недоступном
# Docker Hub укажите доступное зеркало, не трогая файл, например
#   docker build --build-arg BASE_IMAGE=mirror.gcr.io/library/python:3.12-slim ...
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VISTEST_ROOT=/data

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        --no-install-recommends libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md constraints-service.txt ./
COPY vistest ./vistest
COPY frontend ./frontend
# Обычная установка, не editable, и по зафиксированным версиям.
#
# `-e` в образе означало, что пакет «установлен» ссылкой на /app: работает, но
# состояние образа перестаёт быть его содержимым — достаточно смонтировать
# другой /app, и внутри едет другой код при том же теге. Плюс `pip install -e`
# тянет сборочные зависимости в рантайм-образ.
#
# `-c constraints-service.txt` фиксирует и транзитивные версии: две сборки
# одного коммита, разнесённые на неделю, обязаны давать одно и то же.
RUN pip install --no-cache-dir -c constraints-service.txt ".[server]"

VOLUME /data
EXPOSE 8420

# Сервис не делает ничего, что требует root: он читает свой пакет и пишет в
# /data. Работа из-под root здесь — привычка, а не необходимость.
RUN useradd --system --uid 10001 --create-home --home-dir /home/vistest vistest \
    && mkdir -p /data && chown -R vistest:vistest /data /app
USER vistest

HEALTHCHECK --interval=15s --timeout=3s --retries=5 \
  CMD curl -fsS http://localhost:8420/api/health || exit 1

# Без --proxy-headers, и это решение, а не упущение.
#
# `--forwarded-allow-ips *` включает в uvicorn always_trust, а тот берёт из
# `X-Forwarded-For` ПЕРВЫЙ элемент — то есть значение, которое пишет сам
# вызывающий: прокси свой адрес дописывает в конец, а не заменяет строку. После
# этого `request.client.host` подделывается заголовком, а на нём держится
# граница «только с машины сервиса»: правка secrets.env, подключение проекта
# (запуск произвольного процесса), правка тестов, запись с мышью.
#
# Заголовки разбирает сам сервис — `vistest/api/net.py`, список доверенных
# адресов в VISTEST_TRUSTED_PROXIES (пусто = не доверять никому). Схему для
# флага Secure на куке берите оттуда же или задайте VISTEST_COOKIE_SECURE=1.
CMD ["uvicorn", "vistest.api.main:app", "--host", "0.0.0.0", "--port", "8420"]
